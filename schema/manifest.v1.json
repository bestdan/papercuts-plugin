{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bestdan/papercuts/schema/manifest.v1.json",
  "title": "Triage run manifest v1",
  "description": "One run's manifest, written to $PAPERCUT_TRIAGE_DIR/<run-date>.json (dev_docs/designs/2026-09-07-triage-and-route.md §4.5). `papercut_file.py` owns and writes run_date, filed, consolidated, held, noop, and calls on every --apply run. `resolved`, `skipped`, `closed_without_evidence`, and `flush` are written by later tasks (papercut_fixed.py and the triage flush step) against this same schema -- they are declared here so the shape is fixed in advance, but papercut_file.py never populates them.",
  "type": "object",
  "properties": {
    "run_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "filed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "papercut_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "target": { "type": "string" },
          "repo": { "type": "string" },
          "title": { "type": "string" },
          "labels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "url": { "type": "string" }
        },
        "required": ["papercut_ids", "target", "repo", "title", "labels", "url"],
        "additionalProperties": false
      }
    },
    "consolidated": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "papercut_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "target": { "type": "string" },
          "repo": { "type": "string" },
          "issue": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          }
        },
        "required": ["papercut_ids", "target", "repo", "issue"],
        "additionalProperties": false
      }
    },
    "held": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner": { "type": "string" },
          "labels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "clusters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "papercut_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "title": { "type": "string" }
              },
              "required": ["papercut_ids", "title"],
              "additionalProperties": false
            }
          }
        },
        "required": ["owner", "labels", "clusters"],
        "additionalProperties": false
      }
    },
    "noop": { "type": "integer" },
    "resolved": {
      "type": "array",
      "items": { "type": "object" }
    },
    "skipped": {
      "type": "array",
      "items": { "type": "object" }
    },
    "closed_without_evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "flush": { "type": "string" },
    "calls": { "type": "object" }
  },
  "required": ["run_date", "filed", "consolidated", "held", "noop", "calls"],
  "additionalProperties": false
}
